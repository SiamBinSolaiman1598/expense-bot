# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=paste-your-token-here

# Optional: your Telegram user ID (the bot shows it when you send /start).
# When set, only you can use the bot.
ALLOWED_USER_ID=

# Your timezone, so "today" starts at your midnight. Examples: Asia/Dhaka, Asia/Kolkata, Europe/London
TIMEZONE=UTC

# Server only: any long random text. Telegram sends it with every message so strangers can't post fake ones.
WEBHOOK_SECRET=
